# Vorlage für benötigte Umgebungsvariablen.
# Diese Datei ist nur ein Beispiel — echte Werte NIE hier eintragen oder committen.
# In Vercel: Project Settings → Environment Variables.
# Lokal (falls mit `vercel dev` getestet wird): Datei nach .env kopieren und Werte eintragen.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google PageSpeed Insights API (console.cloud.google.com)
PAGESPEED_API_KEY=

# Anthropic API (console.anthropic.com) — nur für den Design-Score im Website-Check
ANTHROPIC_API_KEY=

# Resend (resend.com) — optional, für E-Mail-Benachrichtigung bei neuen Kontaktanfragen
RESEND_API_KEY=
